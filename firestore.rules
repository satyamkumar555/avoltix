rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // Set with scripts/set-admin.mjs (Firebase custom claim). Users cannot set it themselves.
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function str(v, max) { return v is string && v.size() > 0 && v.size() <= max; }

    function validProduct(sku) {
      let d = request.resource.data;
      return d.sku == sku && str(d.name, 160) && d.price is int && d.mrp is int && d.price > 0 && d.price <= d.mrp
        && d.stock is int && d.stock >= 0 && d.status in ['draft', 'published', 'archived'];
    }

    match /products/{sku} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow create, update: if isAdmin() && validProduct(sku);
      allow delete: if isAdmin();
    }
    match /categories/{id} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update: if isAdmin() && str(request.resource.data.name, 100) && request.resource.data.published is bool;
      allow delete: if isAdmin();
    }
    match /siteSettings/{id} { allow read: if true; allow write: if isAdmin(); }

    // Orders are created only by the placeOrder Cloud Function (Admin SDK bypasses rules).
    match /orders/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.customerId == request.auth.uid);
      allow create, delete: if false;
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']);
    }

    // Component requests: a signed-in customer creates their own; admins manage status.
    match /inquiries/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'phone', 'institution', 'contactMethod', 'items', 'message', 'status', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && str(request.resource.data.name, 100) && str(request.resource.data.email, 200) && str(request.resource.data.phone, 20)
        && request.resource.data.institution is string && request.resource.data.institution.size() <= 200
        && request.resource.data.contactMethod in ['Call', 'WhatsApp', 'Email']
        && request.resource.data.items is list && request.resource.data.items.size() >= 1 && request.resource.data.items.size() <= 50
        && request.resource.data.message is string && request.resource.data.message.size() <= 1000
        && request.resource.data.status == 'New' && request.resource.data.createdAt == request.time;
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if false;
    }

    match /banners/{id} {
      allow read: if resource.data.active == true || isAdmin();
      allow create, update: if isAdmin() && str(request.resource.data.imageUrl, 2000) && request.resource.data.active is bool;
      allow delete: if isAdmin();
    }

    match /auditLogs/{id} { allow create: if isAdmin(); allow read: if isAdmin(); allow update, delete: if false; }
    match /inventoryMovements/{id} { allow read: if isAdmin(); allow write: if false; }
    match /counters/{id} { allow read, write: if false; }
    match /users/{uid}/{document=**} { allow read, write: if signedIn() && request.auth.uid == uid; }
    match /{document=**} { allow read, write: if false; }
  }
}
